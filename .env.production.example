# Production environment — Phase 7 (DEPLOYMENT.md). Copy to .env.production
# on the Hetzner box (Coolify: paste into the environment tab). Never commit
# the filled file.
NODE_ENV=production
PORT=3000

POSTGRES_USER=dalio
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=dalio
DATABASE_URL=postgres://dalio:<POSTGRES_PASSWORD>@postgres:5432/dalio
REDIS_URL=redis://redis:6379

BETTER_AUTH_SECRET=<openssl rand -base64 32>
BETTER_AUTH_URL=https://api.<domain>
WEB_ORIGIN=https://app.<domain>

# WAHA control-plane defaults; per-clinic containers set channels.host.
WAHA_BASE_URL=http://waha-<clinic-slug>:3000
WAHA_API_KEY=<openssl rand -hex 24>
WAHA_WEBHOOK_HMAC_SECRET=<openssl rand -hex 32>

ANTHROPIC_API_KEY=<from console.anthropic.com>
AGENT_ROUTER_MODEL=claude-haiku-4-5
AGENT_BOOKING_MODEL=claude-opus-4-8

# LangSmith — EU region workspace only (iron rule #7 / SPEC §8).
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=<from EU workspace>
LANGSMITH_PROJECT=dalio-prod

# Observability (Phase 7) — all optional; features disable cleanly when unset.
SENTRY_DSN=
BULL_BOARD_PASSWORD=<openssl rand -hex 16>
ALERT_WEBHOOK_URL=<Slack/Discord/ntfy incoming-webhook URL>

# apps/web (Vercel project env, not this box)
# NEXT_PUBLIC_API_URL=https://api.<domain>
# NEXT_PUBLIC_SENTRY_DSN=
