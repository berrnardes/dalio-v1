    "@nestjs/platform-express": "^11.0.0",
    "@thallesp/nestjs-better-auth": "^2.6.1",
    "better-auth": "^1.3.0",
    "bullmq": "^5.79.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
