# apps/api reads this from the repo root in dev (copy to .env)
NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://dalio:dalio@localhost:5433/dalio
REDIS_URL=redis://localhost:6379

BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32-min-32-chars
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3100

WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=dev-waha-key
WAHA_WEBHOOK_HMAC_SECRET=dev-hmac-secret

# Agent (Phase 2) — leave ANTHROPIC_API_KEY empty to run agent-less (observe-only)
ANTHROPIC_API_KEY=
AGENT_ROUTER_MODEL=claude-haiku-4-5
AGENT_BOOKING_MODEL=claude-opus-4-8

# LangSmith tracing (SPEC §8) — EU workspace; read automatically by LangChain
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dalio-dev

# apps/web (Phase 3) — defaults to http://localhost:3000 in code; set only
# when the api lives elsewhere (Next inlines NEXT_PUBLIC_* at build time)
NEXT_PUBLIC_API_URL=http://localhost:3000
