{
  "name": "dalio",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up -d && pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @dalio/api db:generate",
    "db:migrate": "pnpm --filter @dalio/api db:migrate",
    "db:seed": "pnpm --filter @dalio/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
